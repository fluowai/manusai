# ==============================================================================
# Variáveis de Ambiente para Portainer (AI Manus)
# ==============================================================================
# Copie e cole estas variáveis no campo "Environment variables" da Stack no Portainer.

# --- Chave e Provedor de LLM ---
# Insira sua chave de API (OpenAI, DeepSeek, Anthropic, Ollama, OpenRouter, etc.)
API_KEY=sk-seu-token-aqui
API_BASE=https://api.openai.com/v1
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o
TEMPERATURE=0.7
MAX_TOKENS=4000

# --- Autenticação ---
# 'none' desativa login (ideal para uso pessoal). 
# 'password' requer registro e autenticação.
AUTH_PROVIDER=none
JWT_SECRET_KEY=gere-uma-chave-secreta-aleatoria-longa-aqui

# --- Motor de Busca na Web ---
# 'bing_web' não requer chave de API!
SEARCH_PROVIDER=bing_web
# BING_SEARCH_API_KEY=
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=
# TAVILY_API_KEY=

# --- Imagens e Portas ---
FRONTEND_IMAGE=ghcr.io/fluowai/manusai/manus-frontend:latest
BACKEND_IMAGE=ghcr.io/fluowai/manusai/manus-backend:latest
SANDBOX_IMAGE=ghcr.io/fluowai/manusai/manus-sandbox:latest
PORT_FRONTEND=5173
PORT_BACKEND=8000

# --- Logs ---
LOG_LEVEL=INFO

